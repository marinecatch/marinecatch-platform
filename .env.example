# MarineCatch Africa — Environment Variables Template
# Copy this file to backend/app/.env and fill in your values
# NEVER commit the real .env file to GitHub

# ── APP ──────────────────────────────────────────────────
APP_NAME=MarineCatch Africa API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# ── SECURITY ─────────────────────────────────────────────
SECRET_KEY=replace_with_random_secret_key_minimum_32_chars

# ── DATABASE ─────────────────────────────────────────────
# Local development:
DATABASE_URL=postgresql://marinecatch_user:your_password@localhost:5432/marinecatch_dev

# ── M-PESA (Safaricom Daraja) ─────────────────────────────
# Get sandbox credentials from developer.safaricom.co.ke
MPESA_CONSUMER_KEY=replace_me
MPESA_CONSUMER_SECRET=replace_me
MPESA_SHORTCODE=174379
MPESA_PASSKEY=replace_me
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=https://your-ngrok-url/api/v1/payments/mpesa/callback

# ── WHATSAPP (Meta Cloud API) ─────────────────────────────
# Get from developers.facebook.com
WHATSAPP_TOKEN=replace_me
WHATSAPP_PHONE_NUMBER_ID=replace_me
WHATSAPP_VERIFY_TOKEN=marinecatch_verify_2026
WHATSAPP_API_VERSION=v25.0

# ── AFRICA'S TALKING (USSD + SMS) ─────────────────────────
# Get from africastalking.com
AT_USERNAME=sandbox
AT_API_KEY=replace_me
AT_USSD_SHORTCODE=replace_me
AT_ENVIRONMENT=sandbox

# ── ZOHO (Future) ─────────────────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_BOOKS_ORG_ID=

# ── AWS (Phase 7 - Deployment) ────────────────────────────
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_REGION=eu-west-1
S3_BUCKET_NAME=marinecatch-documents